# Backend

# PostgreSQL connection. DATABASE_URL is preferred by the backend and Alembic.
DATABASE_URL=postgresql+psycopg://insightbank:password@localhost:5432/bank_analyzer

# Optional component-based PostgreSQL config used only when DATABASE_URL is absent.
DB_TYPE=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_USER=insightbank
DB_PASS=password
DB_NAME=bank_analyzer

# File uploads
UPLOAD_DIR=./uploads

# OCR, optional. Only needed for scanned PDFs.
# TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe

# Frontend
VITE_API_URL=http://localhost:8000/api/v1
