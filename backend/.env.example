# Backend environment for InsightBank-AI

# PostgreSQL connection. DATABASE_URL is preferred by the app and Alembic.
DATABASE_URL=postgresql+psycopg://insightbank:password@localhost:5432/bank_analyzer

# Optional component-based PostgreSQL config used only when DATABASE_URL is absent.
DB_TYPE=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_USER=insightbank
DB_PASS=password
DB_NAME=bank_analyzer

# File uploads
UPLOAD_DIR=./uploads

# Security configuration
JWT_SECRET_KEY=generate_a_random_secret_with_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Rate limits and CORS
RATE_LIMIT_INSIGHTS_PER_MINUTE=1/minute
FRONTEND_ORIGIN=http://localhost:5173
